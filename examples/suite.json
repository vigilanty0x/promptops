      "output_price_microunits_per_1k": 4000
    },
    {
      "id": "verbose",
      "model": "replay-v2",
      "prompt_template": "Explain and answer: {input}",
      "input_price_microunits_per_1k": 3000,
      "output_price_microunits_per_1k": 6000
    }
  ],
