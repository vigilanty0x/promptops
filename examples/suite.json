{
  "schema_version": "1.0",
  "suite_id": "public-example",
  "version": "1.0.0",
  "limits": {
    "repeats": 3,
    "max_output_chars": 1000
  },
  "scenarios": [
    {
      "id": "capital",
      "difficulty": "easy",
      "input": "What is the capital of France?",
      "expected": "Paris",
      "judge": {
        "type": "exact",
        "case_sensitive": false,
        "normalize_whitespace": true
      }
    },
    {
      "id": "structured",
      "difficulty": "medium",
      "input": "Return a JSON object with ok set to true.",
      "expected": {
        "ok": true
      },
      "judge": {
        "type": "json_equal"
      }
    }
  ],
  "candidates": [
    {
      "id": "concise",
      "model": "replay-v1",
      "prompt_template": "Answer concisely: {input}",
