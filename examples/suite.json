        {"output": "The answer is Paris.", "latency_ms": 22, "input_tokens": 8, "output_tokens": 5},
        {"output": "The answer is Paris.", "latency_ms": 21, "input_tokens": 8, "output_tokens": 5}
      ],
      "structured": [
